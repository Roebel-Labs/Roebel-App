# Written by `lk app env -w` (LiveKit CLI). Same project as Vercel LIVEKIT_URL/API_KEY/API_SECRET.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
