{
  "name": "@roebel/card-design",
  "version": "0.1.0",
  "private": true,
  "description": "Card design document (credential designer): schema, validation, hash, templates and Skia drawing shared by Studio, server and app.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./canvaskit": "./src/adapters/canvaskit.ts",
    "./rn-skia": "./src/adapters/rn-skia.ts",
    "./fonts/*": "./fonts/*",
    "./assets/*": "./assets/*"
  },
  "files": [
    "src",
    "fonts",
    "assets"
  ],
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "golden": "tsx scripts/update-golden.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "canvaskit-wasm": "^0.40.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
