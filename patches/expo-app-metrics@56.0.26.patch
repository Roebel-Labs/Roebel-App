-  s.libraries = 'sqlite3'
+  # Mirrors EXUpdates.podspec: when the app also links SQLCipher (XMTP), the
+  # iOS system SQLite3 clang module cannot be built ("unknown type name
+  # 'sqlite3_stmt'"), so honour the same Podfile switch and use the
+  # namespaced sqlite3 pod instead of the system library.
+  podfile_properties = JSON.parse(File.read("#{Pod::Config.instance.installation_root}/Podfile.properties.json")) rescue {}
+  if podfile_properties['expo.updates.useThirdPartySQLitePod'] === 'true'
+    s.dependency 'sqlite3'
+  else
+    s.libraries = 'sqlite3'
+  end
 
   install_modules_dependencies(s)
 
