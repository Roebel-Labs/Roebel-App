{
  "name": "@roebel/expo",
  "main": "./index.js",
  "version": "3.7.0",
  "scripts": {
    "start": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "eas-build-post-install": "bash ./eas-hooks/eas-build-post-prebuild.sh",
    "export": "NODE_OPTIONS=--max-old-space-size=8192 expo export",
    "export:web": "NODE_OPTIONS=--max-old-space-size=8192 expo export --platform web",
    "smoke:web": "node scripts/web-smoke.mjs",
    "deploy:web": "pnpm export:web && ([ -d .vercel ] && cp -R .vercel dist/.vercel || true) && cd dist && npx vercel --prod",
    "update:preview": "NODE_OPTIONS=--max-old-space-size=8192 eas update --channel preview",
    "update:production": "NODE_OPTIONS=--max-old-space-size=8192 eas update --channel production"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|maci-crypto|@zk-kit|circomlibjs|ffjavascript))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
