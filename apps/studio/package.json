{
  "name": "@ortis/studio",
  "productName": "Ortis Studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/patch-electron-plist.cjs && concurrently -k -n vite,electron \"vite --port 5175 --strictPort\" \"wait-on tcp:5175 && cross-env STUDIO_DEV_URL=http://localhost:5175 electron .\"",
    "start": "node scripts/patch-electron-plist.cjs && vite build && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node scripts/patch-electron-plist.cjs",
    "build:renderer": "vite build",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.cjs",
    "dist:mac": "vite build && pnpm dlx electron-builder@26.18.0 --mac --arm64",
    "dist:win": "vite build && pnpm dlx electron-builder@26.18.0 --win --x64",
    "ota:publish": "node scripts/ota-publish.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.75.0",
    "livekit-client": "2.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.0",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "typescript": "^5.6.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wait-on": "^9.5.0"
  },
  "description": "Ortis Studio – Arbeitsbereich mit KI-Assistenten und Livestream-Studio für Vereine und Betriebe",
  "author": "Röbel Labs",
  "homepage": "https://www.roebel.app/studio",
  "build": {
    "appId": "app.roebel.ortisstudio",
    "productName": "Ortis Studio",
    "copyright": "Röbel Labs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**/*.cjs",
      "!electron/__tests__/**",
      "build/icon.png",
      "package.json",
      "build/icon-win.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "build/tray-win.png"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg/${os}",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUseContinuityCameraDeviceType": true,
        "NSCameraUsageDescription": "Ortis Studio nutzt die Kamera für den Livestream.",
        "NSMicrophoneUsageDescription": "Ortis Studio nutzt das Mikrofon für den Livestream."
      }
    },
    "dmg": {
      "artifactName": "Ortis-Studio-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-win.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ortis Studio",
      "artifactName": "Ortis-Studio-${version}-win-x64.${ext}"
    }
  }
}
