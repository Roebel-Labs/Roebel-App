{
  "name": "@roebel/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite --port 5175 --strictPort\" \"wait-on tcp:5175 && cross-env STUDIO_DEV_URL=http://localhost:5175 electron .\"",
    "start": "vite build && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.0",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "typescript": "^5.6.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wait-on": "^9.5.0"
  }
}
